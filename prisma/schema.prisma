generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  phone         String          @unique // Mobile number (e.g. 09132456789)
  email         String?         @unique
  password      String?
  role          String          @default("CUSTOMER") // CUSTOMER, ADMIN
  address       String?
  city          String?         @default("نجف‌آباد")
  postalCode    String?
  nationalCode  String?         // For legal/corporate invoice
  companyName   String?         // For legal invoice
  economicCode  String?         // For legal invoice
  isVerified        Boolean         @default(false)
  tokenVersion      Int             @default(0)
  adminPermissions  String?         // JSON string: ["CATALOG", "ORDERS", "REPAIRS", "REVIEWS"] or ["ALL"]
  isSuspended       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orders            Order[]
  repairs           RepairRequest[]
}

model VerificationToken {
  id             String    @id @default(cuid())
  phone          String
  code           String   // 5-digit OTP code (e.g. 84219)
  expiresAt      DateTime
  resendAttempts Int       @default(0)
  cooldownUntil  DateTime?
  createdAt      DateTime  @default(now())

  @@index([phone, code])
  @@index([phone, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  sku             String?        @unique
  shortDesc       String?
  description     String
  price           Int            // In Toman
  originalPrice   Int?           // In Toman (for discount display)
  discountPercent Int            @default(0)
  stock           Int            @default(10)
  isFeatured      Boolean        @default(false)
  isBestSeller    Boolean        @default(false)
  isNewArrival    Boolean        @default(false)
  isIsfahanFast   Boolean        @default(true) // Ready for fast delivery in Najafabad & Isfahan
  brand           String?
  warranty        String?        @default("گارانتی اصالت و سلامت فیزیکی")
  madeIn          String?        @default("ایران")
  rating          Float          @default(4.8)
  reviewCount     Int            @default(0)
  priceUnit       String?        // e.g. "متر", "عدد", "کلاف", "شاخه", "کیلوگرم", "بسته"
  isArchived      Boolean        @default(false)
  datasheetUrl    String?        // PDF Datasheet download link
  mpn             String?        // Manufacturer Part Number (e.g. ESP32-WROOM-32D, NE555)
  moq             Int            @default(1) // Minimum Order Quantity
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  specs           ProductSpec[]
  reviews         Review[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isFeatured, isBestSeller])
  @@index([categoryId])
  @@index([brand])
  @@index([isArchived])
  @@index([createdAt])
  @@index([isArchived, createdAt])
  @@index([isArchived, price])
  @@index([isArchived, categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpec {
  id        String   @id @default(cuid())
  label     String   // e.g. "ولتاژ کاری", "جنس بدنه", "توان مصرفی"
  value     String   // e.g. "220 ولت", "مس خالص", "50 وات"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  city       String?  @default("نجف‌آباد")
  rating     Int      @default(5)
  comment    String
  isVerified Boolean  @default(true)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isVerified])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // e.g. SH-140306-102
  customerName   String
  customerPhone  String
  customerEmail  String?
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  province       String      @default("اصفهان")
  city           String      @default("نجف‌آباد")
  postalCode     String?
  address        String
  isCorporate    Boolean     @default(false) // فاکتور رسمی / حقوقی
  companyName    String?
  economicCode   String?
  nationalCode   String?
  shippingMethod String      // isfahan_express, najafabad_pickup, tipax, post_pishtaz
  shippingCost   Int         @default(0)
  paymentMethod  String      // zarinpal, cod_isfahan, card_to_card
  paymentStatus  String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus    String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  trackingCode   String?     // Tipax/Post/Courier tracking code
  subtotal       Int         // In Toman
  discount       Int         @default(0)
  totalAmount    Int         // In Toman
  paymentRefId   String?     // Zarinpal/Bank reference id
  receiptImage   String?     // Card-to-card proof
  reservedUntil  DateTime?   // 8-hour Card-to-Card reservation expiration window
  notes          String?
  items          OrderItem[]
  paymentLogs    PaymentTransactionLog[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([customerPhone])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentMethod, orderStatus, reservedUntil])
}

model OrderItem {
  id              String   @id @default(cuid())
  productId       String?
  productName     String
  productImage    String?
  price           Int      // Price at time of purchase in Toman
  quantity        Int
  discountPercent Int      @default(0) // Tiered wholesale discount (0, 5, or 10%)
  total           Int
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model RepairRequest {
  id                 String    @id @default(cuid())
  trackingCode       String    @unique // e.g. REP-1403-082
  customerName       String
  customerPhone      String
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  applianceType      String    // پنکه، کولر آبی، بخاری برقی، آنتن، چای‌ساز، برد الکترونیکی، سایر
  brandModel         String?   // مثلا: پارس خزر، موتوژن، اخوان، هانی
  issueDesc          String    // شرح خرابی
  deliveryType       String    @default("in_person") // in_person (تحویل حضوری در شعبه نجف‌آباد), courier (پیک نجف‌آباد)
  status             String    @default("SUBMITTED") // SUBMITTED, RECEIVED, INSPECTING, COST_ESTIMATED, REPAIRING, READY, DELIVERED, CANCELLED
  costApprovalStatus String?   @default("PENDING") // PENDING, APPROVED, DECLINED
  approvalChannel    String?   // PORTAL, SMS, PHONE
  approvalTimestamp  DateTime?
  estimatedCost      Int?      // In Toman
  finalCost          Int?      // In Toman
  adminNotes         String?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerPhone])
  @@index([status])
  @@index([isArchived])
  @@index([userId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int?      // Percentage (e.g. 10%)
  discountAmount  Int?      // Fixed Toman (e.g. 50000)
  minOrderAmount  Int       @default(0)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String   @db.Text
  content     String   @db.Text
  category    String   // e.g. "نورپردازی و روشنایی", "طراحی لاین نوری", "سرویس و تعمیرات"
  tags        String   // Comma-separated tags, e.g. "روشنایی_مدرن, چراغ_سقفی, پنل_SMD"
  readTime    String   // e.g. "۴ دقیقه مطالعه"
  image       String   // Feature image URL
  authorName  String   @default("کارشناس فنی فروشگاه شیاسی")
  isPublished Boolean  @default(true)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([createdAt])
}

model BOMSubmission {
  id              String   @id @default(cuid())
  trackingCode    String   @unique // e.g. BOM-YYMMDD-XXX
  contractorName  String
  contractorPhone String
  projectCity     String?
  companyName     String?
  content         String?  @db.Text
  fileUrl         String?
  fileType        String?
  status          String   @default("PENDING") // PENDING, QUOTED, CONTACTED, ARCHIVED
  adminNotes      String?  @db.Text
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contractorPhone])
  @@index([status])
  @@index([isArchived])
  @@index([createdAt])
}

model ManufacturerPriceList {
  id                String   @id @default(cuid())
  brand             String   // e.g. "سیم و کابل البرز", "موتوژن", "الکتروژن"
  title             String
  category          String?
  fileUrl           String
  fileSize          String?
  discountCoeff     Float?
  publishDateJalali String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([brand])
  @@index([isActive])
}

model PaymentTransactionLog {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber     String   // Denormalized snapshot for audit preservation
  gateway         String   // zarinpal, card_to_card, cod_isfahan
  transactionType String   // INITIATE, VERIFY, WEBHOOK, ADMIN_CONFIRM, REVERT
  status          String   // PENDING, SUCCESS, FAILED, CANCELLED
  amount          Int      // In Toman
  authority       String?  // Gateway tracking token / authority code
  referenceId     String?  // Gateway / Bank transaction reference number
  cardPan         String?  // Masked card number (e.g. 6037-99**-****-1234)
  cardHash        String?  // Secure hash of card number
  statusCode      String?  // Raw gateway response code (e.g. "100", "101", "-9")
  errorMessage    String?  // Detailed error explanation if failed
  metadata        String?  @db.Text // Raw JSON string of payload / gateway response
  ipAddress       String?  // Client or gateway IP address
  userAgent       String?  // Client User-Agent string
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([orderNumber])
  @@index([authority])
  @@index([referenceId])
  @@index([status])
  @@index([createdAt])
}

