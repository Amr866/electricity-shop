generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  sku             String?        @unique
  shortDesc       String?
  description     String
  price           Int            // In Toman
  originalPrice   Int?           // In Toman (for discount display)
  discountPercent Int            @default(0)
  stock           Int            @default(10)
  isFeatured      Boolean        @default(false)
  isBestSeller    Boolean        @default(false)
  isNewArrival    Boolean        @default(false)
  isIsfahanFast   Boolean        @default(true) // Ready for fast delivery in Najafabad & Isfahan
  brand           String?
  warranty        String?        @default("گارانتی اصالت و سلامت فیزیکی")
  madeIn          String?        @default("ایران")
  rating          Float          @default(4.8)
  reviewCount     Int            @default(0)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  specs           ProductSpec[]
  reviews         Review[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        String   @id @default(cuid())
  label     String   // e.g. "ولتاژ کاری", "جنس بدنه", "توان مصرفی"
  value     String   // e.g. "220 ولت", "مس خالص", "50 وات"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  authorName String
  city       String?  @default("نجف‌آباد")
  rating     Int      @default(5)
  comment    String
  isVerified Boolean  @default(true)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // e.g. SH-140306-102
  customerName   String
  customerPhone  String
  customerEmail  String?
  province       String      @default("اصفهان")
  city           String      @default("نجف‌آباد")
  postalCode     String?
  address        String
  shippingMethod String      // isfahan_express, najafabad_pickup, tipax, post_pishtaz
  shippingCost   Int         @default(0)
  paymentMethod  String      // zarinpal, cod_isfahan, card_to_card
  paymentStatus  String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus    String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  trackingCode   String?     // Tipax/Post/Courier tracking code
  subtotal       Int         // In Toman
  discount       Int         @default(0)
  totalAmount    Int         // In Toman
  paymentRefId   String?     // Zarinpal/Bank reference id
  receiptImage   String?     // Card-to-card proof
  notes          String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  productId    String?
  productName  String
  productImage String?
  price        Int      // Price at time of purchase in Toman
  quantity     Int
  total        Int
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model RepairRequest {
  id            String   @id @default(cuid())
  trackingCode  String   @unique // e.g. REP-1403-082
  customerName  String
  customerPhone String
  applianceType String   // پنکه، کولر آبی، بخاری برقی، آنتن، چای‌ساز، برد الکترونیکی، سایر
  brandModel    String?  // مثلا: پارس خزر، موتوژن، اخوان، هانی
  issueDesc     String   // شرح خرابی
  deliveryType  String   @default("in_person") // in_person (تحویل حضوری در شعبه نجف‌آباد), courier (پیک نجف‌آباد)
  status        String   @default("SUBMITTED") // SUBMITTED, IN_PROGRESS, READY, DELIVERED, CANCELLED
  estimatedCost Int?     // In Toman
  finalCost     Int?     // In Toman
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int?      // Percentage (e.g. 10%)
  discountAmount  Int?      // Fixed Toman (e.g. 50000)
  minOrderAmount  Int       @default(0)
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
